@page
@model Somtumzing.Backend.Api.Pages.Admin.LoginModel
@{
    Layout = null;
}
<!doctype html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>เข้าสู่ระบบ - Somtumzing Back Office</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Kanit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="login-body">
    <div class="login-card">
        <div class="login-brand">
            <svg class="login-brand-logo" viewBox="0 0 100 100" width="72" height="72" aria-hidden="true">
                <ellipse cx="50" cy="72" rx="34" ry="12" fill="rgba(0,0,0,0.06)"/>
                <path d="M22 36 C22 28, 78 28, 78 36 L68 76 C66 82, 34 82, 32 76 Z" fill="#e64a19" stroke="#3d2314" stroke-width="2.2"/>
                <ellipse cx="50" cy="36" rx="26" ry="6" fill="#ff763b" stroke="#3d2314" stroke-width="1.8"/>
                <path d="M52 14 L68 54 C70 58, 62 62, 58 58 L46 22 Z" fill="#8d6e63" stroke="#3d2314" stroke-width="2"/>
                <path d="M12 45 Q5 40 22 25 Q28 20 18 35 Z" fill="#c62828" stroke="#3d2314" stroke-width="1.5"/>
            </svg>
            <h1>Somtumzing Back Office</h1>
            <p>เข้าสู่ระบบเพื่อจัดการเกมส้มตำซิ่ง</p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="login-error" role="alert">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form method="post" class="login-form">
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

            <div class="form-group">
                <label for="Input_Email">อีเมล หรือ ชื่อผู้ใช้</label>
                <input type="text" id="Input_Email" name="Input.Email" placeholder="admin@somtumzing.com"
                       autocomplete="username" required
                       value="@Model.Input.Email" />
            </div>

            <div class="form-group">
                <label for="Input_Password">รหัสผ่าน</label>
                <div class="password-wrapper">
                    <input type="password" id="Input_Password" name="Input.Password"
                           autocomplete="current-password" placeholder="••••••••" required />
                    <button type="button" class="password-toggle-btn" id="passwordToggle" aria-label="แสดง/ซ่อนรหัสผ่าน">
                        <svg id="eyeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
            </div>

            <label class="remember-me-container">
                <input type="checkbox" name="Input.RememberMe" value="true" class="remember-me-checkbox" />
                <span>จดจำการเข้าสู่ระบบ</span>
            </label>

            <button type="submit" class="btn btn-primary btn-block" style="padding: 13px 20px; font-size: 0.95rem;">
                <span>เข้าสู่ระบบ</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </button>
        </form>
    </div>

    <script>
        const passwordInput = document.getElementById('Input_Password');
        const passwordToggle = document.getElementById('passwordToggle');
        const eyeIcon = document.getElementById('eyeIcon');

        passwordToggle.addEventListener('click', () => {
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);
            if (type === 'text') {
                eyeIcon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
            } else {
                eyeIcon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
            }
        });
    </script>
</body>
</html>
