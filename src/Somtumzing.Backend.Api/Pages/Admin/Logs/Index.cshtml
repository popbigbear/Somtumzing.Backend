@page
@model Somtumzing.Backend.Api.Pages.Admin.Logs.IndexModel
@{
    ViewData["Title"] = "บันทึกระบบ";
}

<div class="section-header">
    <div>
        <div class="section-title">บันทึกระบบ (Audit Logs)</div>
        <div class="section-subtitle">ตรวจสอบกิจกรรมและเหตุการณ์ทั้งหมดในระบบ</div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get">
            <div asp-validation-summary="All" role="alert"></div>
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="EventType" class="form-label">ประเภทเหตุการณ์</label>
                    <select asp-for="EventType">
                        <option value="">ทั้งหมด</option>
                        @foreach (var eventType in Model.EventTypes)
                        {
                            <option value="@eventType">@eventType</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="Severity" class="form-label">ระดับความรุนแรง</label>
                    <select asp-for="Severity">
                        <option value="">ทั้งหมด</option>
                        <option>Trace</option>
                        <option>Debug</option>
                        <option>Information</option>
                        <option>Warning</option>
                        <option>Error</option>
                        <option>Critical</option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="From" class="form-label">จากวันที่ (UTC)</label>
                    <input asp-for="From" type="date" />
                </div>
                <div class="form-group">
                    <label asp-for="To" class="form-label">ถึงวันที่ (UTC)</label>
                    <input asp-for="To" type="date" />
                </div>
                <div class="form-group">
                    <label asp-for="IpAddress" class="form-label">IP Address</label>
                    <input asp-for="IpAddress" placeholder="0.0.0.0" />
                </div>
                <div class="form-group">
                    <label asp-for="Username" class="form-label">ชื่อผู้ใช้</label>
                    <input asp-for="Username" placeholder="ค้นหาชื่อ..." />
                </div>
                <div style="display: flex; gap: 12px; align-items: flex-end;">
                    <button type="submit" class="btn btn-primary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                        กรอง
                    </button>
                    <a asp-page="/Admin/Logs/Index" class="btn btn-secondary">ล้าง</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="pagination">
    <span class="pagination-info">@Model.TotalCount เหตุการณ์ · หน้า @Model.CurrentPage จาก @Model.TotalPages</span>
    @if (Model.CurrentPage > 1)
    {
        <a asp-page="/Admin/Logs/Index"
           asp-route-eventType="@Model.EventType"
           asp-route-severity="@Model.Severity"
           asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))"
           asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))"
           asp-route-ipAddress="@Model.IpAddress"
           asp-route-username="@Model.Username"
           asp-route-pageNumber="@(Model.CurrentPage - 1)">ก่อนหน้า</a>
    }
    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a asp-page="/Admin/Logs/Index"
           asp-route-eventType="@Model.EventType"
           asp-route-severity="@Model.Severity"
           asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))"
           asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))"
           asp-route-ipAddress="@Model.IpAddress"
           asp-route-username="@Model.Username"
           asp-route-pageNumber="@(Model.CurrentPage + 1)">ถัดไป</a>
    }
</div>

<div class="card">
    <div class="card-body" style="padding: 0;">
        @if (Model.Entries.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                </div>
                <p class="empty-state-text">ไม่พบบันทึกที่ตรงกับเงื่อนไข</p>
            </div>
        }
        else
        {
            <div class="table-wrapper" style="border: none;">
                <table>
                    <thead>
                        <tr>
                            <th>เวลา (UTC)</th>
                            <th>เหตุการณ์</th>
                            <th>ระดับ</th>
                            <th>ผลลัพธ์</th>
                            <th>ผู้กระทำ</th>
                            <th>IP</th>
                            <th>เป้าหมาย</th>
                            <th>รหัสคำขอ</th>
                            <th>รายละเอียด</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Entries)
                        {
                            var severityBadge = entry.Severity switch
                            {
                                "Error" or "Critical" => "badge-danger",
                                "Warning" => "badge-warning",
                                "Information" => "badge-info",
                                _ => "badge-neutral"
                            };
                            <tr>
                                <td class="text-sm" style="white-space: nowrap;">@entry.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="font-bold">@entry.EventType</td>
                                <td><span class="badge @severityBadge">@entry.Severity</span></td>
                                <td>@entry.Outcome</td>
                                <td>@(entry.ActorUsername ?? "-")</td>
                                <td class="text-sm text-muted">@(entry.IpAddress ?? "-")</td>
                                <td class="text-sm">@entry.TargetType @entry.TargetId</td>
                                <td><code class="text-xs">@entry.RequestId</code></td>
                                <td><code class="text-xs" style="max-width: 300px; display: inline-block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@entry.DetailsJson</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
