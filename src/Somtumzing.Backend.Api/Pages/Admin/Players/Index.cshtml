@page
@model Somtumzing.Backend.Api.Pages.Admin.Players.IndexModel
@{
    ViewData["Title"] = "จัดการผู้เล่น";
}

<div class="section-header">
    <div>
        <div class="section-title">จัดการผู้เล่น</div>
        <div class="section-subtitle">ค้นหา และดูแลบัญชีผู้เล่นในระบบ</div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get">
            <div asp-validation-summary="All" role="alert"></div>
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="Search" class="form-label">ค้นหา (ชื่อ / อีเมล / ID)</label>
                    <input asp-for="Search" placeholder="พิมพ์เพื่อค้นหา..." />
                </div>
                <div class="form-group">
                    <label asp-for="Status" class="form-label">สถานะบัญชี</label>
                    <select asp-for="Status">
                        <option>ทั้งหมด</option>
                        <option>ใช้งาน</option>
                        <option>ระงับ</option>
                    </select>
                </div>
                <div style="display: flex; gap: 12px; align-items: flex-end;">
                    <button type="submit" class="btn btn-primary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        ค้นหา
                    </button>
                    <a asp-page="/Admin/Players/Index" class="btn btn-secondary">ล้าง</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="pagination">
    <span class="pagination-info">@Model.TotalCount ผู้เล่น · หน้า @Model.CurrentPage จาก @Model.TotalPages</span>
    @if (Model.CurrentPage > 1)
    {
        <a asp-page="/Admin/Players/Index"
           asp-route-search="@Model.Search"
           asp-route-status="@Model.Status"
           asp-route-pageNumber="@(Model.CurrentPage - 1)">ก่อนหน้า</a>
    }
    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a asp-page="/Admin/Players/Index"
           asp-route-search="@Model.Search"
           asp-route-status="@Model.Status"
           asp-route-pageNumber="@(Model.CurrentPage + 1)">ถัดไป</a>
    }
</div>

<div class="card">
    <div class="card-body" style="padding: 0;">
        @if (Model.Players.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="7" r="4"/><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/></svg>
                </div>
                <p class="empty-state-text">ไม่พบผู้เล่นที่ตรงกับเงื่อนไข</p>
            </div>
        }
        else
        {
            <div class="table-wrapper" style="border: none;">
                <table>
                    <thead>
                        <tr>
                            <th>ผู้เล่น</th>
                            <th>รหัส</th>
                            <th>สร้างเมื่อ (UTC)</th>
                            <th>สถานะ</th>
                            <th>การดำเนินการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var player in Model.Players)
                        {
                            <tr>
                                <td>
                                    <div class="font-bold">@player.Username</div>
                                    @if (!string.IsNullOrWhiteSpace(player.Email))
                                    {
                                        <div class="text-xs text-muted">@player.Email</div>
                                    }
                                    @if (player.IsSuspended)
                                    {
                                        <div class="text-xs text-danger" style="margin-top: 4px;">
                                            ระงับเมื่อ @player.SuspendedAtUtc?.ToString("yyyy-MM-dd HH:mm")
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(player.SuspensionReason))
                                        {
                                            <div class="text-xs text-muted">เหตุผล: @player.SuspensionReason</div>
                                        }
                                    }
                                </td>
                                <td><code>@player.Id</code></td>
                                <td class="text-sm">@player.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    @if (player.IsSuspended)
                                    {
                                        <span class="badge badge-danger"><span class="badge-dot danger"></span>ระงับ</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success"><span class="badge-dot success"></span>ใช้งาน</span>
                                    }
                                </td>
                                <td>
                                    <form method="post" asp-page-handler="@(player.IsSuspended ? "Reactivate" : "Suspend")" style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                                        <input type="hidden" name="Input.UserId" value="@player.Id" />
                                        <input type="hidden" name="Search" value="@Model.Search" />
                                        <input type="hidden" name="Status" value="@Model.Status" />
                                        <input type="hidden" name="PageNumber" value="@Model.CurrentPage" />
                                        <input id="reason-@player.Id"
                                               name="Input.Reason"
                                               placeholder="เหตุผล..."
                                               maxlength="500"
                                               minlength="3"
                                               required
                                               style="width: 180px; padding: 7px 10px; font-size: 0.82rem;" />
                                        @if (player.IsSuspended)
                                        {
                                            <button type="submit" class="btn btn-success btn-sm">ปลดระงับ</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-danger btn-sm">ระงับ</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
