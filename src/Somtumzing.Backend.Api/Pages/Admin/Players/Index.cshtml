@page
@model Somtumzing.Backend.Api.Pages.Admin.Players.IndexModel
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Manage players - Somtumzing Back Office</title>
</head>
<body>
    <main>
        <nav>
            <a asp-page="/Admin/Index">Back office</a>
            <a asp-page="/Admin/Logs/Index">Audit logs</a>
        </nav>
        <h1>Manage players</h1>
        @if (TempData["StatusMessage"] is string statusMessage)
        {
            <p role="status">@statusMessage</p>
        }

        <form method="get">
            <div asp-validation-summary="All" role="alert"></div>
            <label asp-for="Search">Username, email, or player ID</label>
            <input asp-for="Search" />
            <label asp-for="Status">Account status</label>
            <select asp-for="Status">
                <option>All</option>
                <option>Active</option>
                <option>Suspended</option>
            </select>
            <button type="submit">Search</button>
            <a asp-page="/Admin/Players/Index">Clear</a>
        </form>

        <p>@Model.TotalCount player(s). Page @Model.CurrentPage of @Model.TotalPages.</p>
        @if (Model.Players.Count == 0)
        {
            <p>No players match these filters.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th scope="col">Username</th>
                        <th scope="col">Player ID</th>
                        <th scope="col">Created (UTC)</th>
                        <th scope="col">Status</th>
                        <th scope="col">Moderation</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var player in Model.Players)
                    {
                        <tr>
                            <td>
                                <strong>@player.Username</strong>
                                @if (!string.IsNullOrWhiteSpace(player.Email))
                                {
                                    <br />
                                    <span>@player.Email</span>
                                }
                                @if (player.IsSuspended)
                                {
                                    <br />
                                    <span>Suspended @player.SuspendedAtUtc?.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
                                    <br />
                                    <span>Reason: @player.SuspensionReason</span>
                                }
                            </td>
                            <td>@player.Id</td>
                            <td>@player.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@(player.IsSuspended ? "Suspended" : "Active")</td>
                            <td>
                                <form method="post" asp-page-handler="@(player.IsSuspended ? "Reactivate" : "Suspend")">
                                    <input type="hidden" name="Input.UserId" value="@player.Id" />
                                    <input type="hidden" name="Search" value="@Model.Search" />
                                    <input type="hidden" name="Status" value="@Model.Status" />
                                    <input type="hidden" name="PageNumber" value="@Model.CurrentPage" />
                                    <label for="reason-@player.Id">
                                        @(player.IsSuspended ? "Reason for reactivation" : "Reason for suspension")
                                    </label>
                                    <input id="reason-@player.Id"
                                           name="Input.Reason"
                                           maxlength="500"
                                           minlength="3"
                                           required />
                                    <button type="submit">@(player.IsSuspended ? "Reactivate" : "Suspend")</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <nav aria-label="Player pages">
            @if (Model.CurrentPage > 1)
            {
                <a asp-page="/Admin/Players/Index"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-pageNumber="@(Model.CurrentPage - 1)">Previous</a>
            }
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-page="/Admin/Players/Index"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-pageNumber="@(Model.CurrentPage + 1)">Next</a>
            }
        </nav>
    </main>
</body>
</html>
