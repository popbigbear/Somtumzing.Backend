@page
@model Somtumzing.Backend.Api.Pages.Admin.ReportsModel
@{
    ViewData["Title"] = "รายงาน";
}

<div class="section-header">
    <div>
        <div class="section-title">รายงานภาพรวม</div>
        <div class="section-subtitle">สถิติและข้อมูลสรุปของเกมส้มตำซิ่ง</div>
    </div>
</div>

<!-- Stat Cards -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        </div>
        <div class="stat-card-label">ผู้เล่นทั้งหมด</div>
        <div class="stat-card-value">@Model.PlayerGrowth.TotalPlayers</div>
        <div class="stat-card-sub">@Model.PlayerGrowth.SuspendedPlayers ถูกระงับ</div>
    </div>
    <div class="stat-card info">
        <div class="stat-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </div>
        <div class="stat-card-label">เซสชันทั้งหมด</div>
        <div class="stat-card-value">@Model.Sessions.TotalSessions</div>
        <div class="stat-card-sub">วันนี้ @Model.Sessions.TodaySessions · จบแล้ว @Model.Sessions.CompletedSessions</div>
    </div>
    <div class="stat-card success">
        <div class="stat-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <div class="stat-card-label">กำไรสุทธิเฉลี่ย</div>
        <div class="stat-card-value">@Model.Sessions.AvgNetProfit.ToString("F2")</div>
        <div class="stat-card-sub">ต่อเซสชัน</div>
    </div>
    <div class="stat-card warning">
        <div class="stat-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <div class="stat-card-label">เหตุการณ์ 7 วัน</div>
        <div class="stat-card-value">@Model.AuditSummary.TotalEvents</div>
        <div class="stat-card-sub">@Model.AuditSummary.Warnings เตือน · @Model.AuditSummary.Errors ผิดพลาด</div>
    </div>
</div>

<div class="grid-2 mb-3">
    <!-- Player Growth Chart -->
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">ผู้เล่นใหม่ 7 วันล่าสุด</h2>
        </div>
        <div class="card-body">
            <div class="chart-container">
                @{
                    var maxCount = Model.PlayerGrowth.DailyCounts.Count > 0 ? Model.PlayerGrowth.DailyCounts.Max(d => d.Count) : 1;
                    if (maxCount == 0) { maxCount = 1; }
                }
                @foreach (var day in Model.PlayerGrowth.DailyCounts)
                {
                    <div class="chart-bar-group">
                        <div class="chart-bar-value">@day.Count</div>
                        <div class="chart-bar" style="height: @(Math.Max(4, (day.Count * 160.0 / maxCount)))px;" title="@day.Count ผู้เล่น"></div>
                        <div class="chart-bar-label">@day.Date.ToString("dd/MM")</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sessions by Day Chart -->
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">เซสชันเกม 7 วันล่าสุด</h2>
        </div>
        <div class="card-body">
            <div class="chart-container">
                @{
                    var maxSessions = Model.SessionsByDay.Count > 0 ? Model.SessionsByDay.Max(d => d.Count) : 1;
                    if (maxSessions == 0) { maxSessions = 1; }
                }
                @foreach (var day in Model.SessionsByDay)
                {
                    <div class="chart-bar-group">
                        <div class="chart-bar-value">@day.Count</div>
                        <div class="chart-bar" style="height: @(Math.Max(4, (day.Count * 160.0 / maxSessions)))px; background: linear-gradient(180deg, #38bdf8, #2563eb);" title="@day.Count เซสชัน"></div>
                        <div class="chart-bar-label">@day.Date.ToString("dd/MM")</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Content Summary -->
<div class="card mb-3">
    <div class="card-header">
        <h2 class="card-title">สรุปเนื้อหาเกม</h2>
    </div>
    <div class="card-body">
        <div class="stat-grid" style="margin-bottom: 0;">
            <div class="stat-card info" style="box-shadow: none; border: 1px solid var(--border);">
                <div class="stat-card-label">ด่าน (Stages)</div>
                <div class="stat-card-value">@Model.Content.TotalStages</div>
            </div>
            <div class="stat-card success" style="box-shadow: none; border: 1px solid var(--border);">
                <div class="stat-card-label">ภารกิจ (Missions)</div>
                <div class="stat-card-value">@Model.Content.TotalMissions</div>
            </div>
            <div class="stat-card warning" style="box-shadow: none; border: 1px solid var(--border);">
                <div class="stat-card-label">ความสำเร็จ (Achievements)</div>
                <div class="stat-card-value">@Model.Content.TotalAchievements</div>
            </div>
            <div class="stat-card" style="box-shadow: none; border: 1px solid var(--border);">
                <div class="stat-card-label">กิจกรรม (Events)</div>
                <div class="stat-card-value">@Model.Content.TotalEvents</div>
                <div class="stat-card-sub">@Model.Content.ActiveEvents กำลังดำเนิน</div>
            </div>
            <div class="stat-card info" style="box-shadow: none; border: 1px solid var(--border);">
                <div class="stat-card-label">อัพเกรด (Upgrades)</div>
                <div class="stat-card-value">@Model.Content.TotalUpgrades</div>
            </div>
            <div class="stat-card danger" style="box-shadow: none; border: 1px solid var(--border);">
                <div class="stat-card-label">การ์ดซิ่ง (Sabotage)</div>
                <div class="stat-card-value">@Model.Content.TotalSabotageCards</div>
            </div>
            <div class="stat-card warning" style="box-shadow: none; border: 1px solid var(--border);">
                <div class="stat-card-label">เหตุการณ์วุ่นวาย</div>
                <div class="stat-card-value">@Model.Content.TotalChaosEvents</div>
            </div>
        </div>
    </div>
</div>

<!-- Stage Progress -->
<div class="card">
    <div class="card-header">
        <h2 class="card-title">ความคืบหน้าด่านเกม (Top 20)</h2>
    </div>
    <div class="card-body" style="padding: 0;">
        @if (Model.StageProgress.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/></svg>
                </div>
                <p class="empty-state-text">ยังไม่มีข้อมูลความคืบหน้า</p>
            </div>
        }
        else
        {
            <div class="table-wrapper" style="border: none;">
                <table>
                    <thead>
                        <tr>
                            <th>รหัสด่าน</th>
                            <th>ผู้เล่นที่เข้าเล่น</th>
                            <th>ผู้เล่นที่ผ่าน</th>
                            <th>ดาวสูงสุด</th>
                            <th>กำไรสุทธิสูงสุด</th>
                            <th>อัตราผ่าน</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stage in Model.StageProgress)
                        {
                            var completionRate = stage.PlayerCount > 0 ? (stage.CompletedCount * 100.0 / stage.PlayerCount) : 0;
                            <tr>
                                <td><code>@stage.StagePK</code></td>
                                <td>@stage.PlayerCount</td>
                                <td>@stage.CompletedCount</td>
                                <td>
                                    <span class="badge badge-warning">@stage.MaxStars ดาว</span>
                                </td>
                                <td class="font-bold">@stage.MaxNetProfit.ToString("F2")</td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <div class="progress-bar" style="flex: 1; min-width: 80px;">
                                            <div class="progress-bar-fill" style="width: @completionRate.ToString("F0")%;"></div>
                                        </div>
                                        <span class="text-sm font-bold">@completionRate.ToString("F1")%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
