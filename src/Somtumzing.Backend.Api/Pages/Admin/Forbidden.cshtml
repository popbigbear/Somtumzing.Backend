@page
@model Somtumzing.Backend.Api.Pages.Admin.ForbiddenModel
@{
    Layout = null;
}
<!doctype html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ไม่มีสิทธิ์เข้าถึง - Somtumzing Back Office</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Kanit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="login-body">
    <div class="login-card" style="text-align: center;">
        <div style="width: 72px; height: 72px; margin: 0 auto 20px; border-radius: 50%; background: var(--danger-bg); display: flex; align-items: center; justify-content: center;">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--danger)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="15" y1="9" x2="9" y2="15"/>
                <line x1="9" y1="9" x2="15" y2="15"/>
            </svg>
        </div>
        <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--text); margin-bottom: 8px;">ไม่มีสิทธิ์เข้าถึง</h1>
        <p style="color: var(--text-muted); margin-bottom: 24px;">บัญชีนี้ไม่มีสิทธิ์เข้าใช้งานส่วนผู้ดูแลระบบ</p>
        <a asp-page="/Admin/Login" class="btn btn-primary btn-block">เข้าสู่ระบบด้วยบัญชีอื่น</a>
    </div>
</body>
</html>
