@page
@model Somtumzing.Backend.Api.Pages.Admin.IndexModel
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Somtumzing Back Office</title>
</head>
<body>
    <main>
        <h1>Somtumzing Back Office</h1>
        <p>Signed in as @User.Identity?.Name</p>
        <p>Manage player accounts and review important system events.</p>
        <nav>
            <a asp-page="/Admin/Players/Index">Manage players</a>
            <a asp-page="/Admin/Logs/Index">Audit logs</a>
        </nav>
        <form method="post" asp-page-handler="SignOut">
            <button type="submit">Sign out</button>
        </form>
    </main>
</body>
</html>
