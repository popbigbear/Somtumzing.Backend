@page
@model Somtumzing.Backend.Api.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "แดชบอร์ด";
}

<!-- Stat Cards -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="stat-card-label">ผู้เล่นทั้งหมด</div>
        <div class="stat-card-value">@Model.Stats.TotalPlayers</div>
        <div class="stat-card-sub">+@Model.Stats.NewPlayersThisWeek สัปดาห์นี้</div>
    </div>

    <div class="stat-card success">
        <div class="stat-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div class="stat-card-label">ผู้เล่นใช้งานอยู่</div>
        <div class="stat-card-value">@Model.Stats.ActivePlayers</div>
        <div class="stat-card-sub">@Model.Stats.SuspendedPlayers ถูกระงับ</div>
    </div>

    <div class="stat-card info">
        <div class="stat-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <div class="stat-card-label">เซสชันเกมวันนี้</div>
        <div class="stat-card-value">@Model.Stats.SessionsToday</div>
        <div class="stat-card-sub">รวมทั้งหมด @Model.Stats.TotalGameSessions เซสชัน</div>
    </div>

    <div class="stat-card warning">
        <div class="stat-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="9" x2="15" y2="9"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
        </div>
        <div class="stat-card-label">เนื้อหาเกม</div>
        <div class="stat-card-value">@Model.Stats.TotalStages</div>
        <div class="stat-card-sub">@Model.Stats.TotalMissions ภารกิจ · @Model.Stats.TotalAchievements ความสำเร็จ · @Model.Stats.TotalEvents กิจกรรม</div>
    </div>
</div>

<!-- Top Players + Recent Activity -->
<div class="grid-2">
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">ผู้เล่นคะแนนสูงสุด</h2>
            <a asp-page="/Admin/Players/Index" class="btn-link">ดูทั้งหมด</a>
        </div>
        <div class="card-body" style="padding: 0;">
            @if (Model.TopPlayers.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="7" r="4"/><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/></svg>
                    </div>
                    <p class="empty-state-text">ยังไม่มีผู้เล่นในระบบ</p>
                </div>
            }
            else
            {
                <div class="table-wrapper" style="border: none;">
                    <table>
                        <thead>
                            <tr>
                                <th>อันดับ</th>
                                <th>ผู้เล่น</th>
                                <th>คะแนนสูงสุด</th>
                                <th>เหรียญ</th>
                                <th>เสิร์ฟ</th>
                                <th>สถานะ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.TopPlayers.Count; i++)
                            {
                                var player = Model.TopPlayers[i];
                                <tr>
                                    <td>
                                        <span class="badge badge-neutral">@(i + 1)</span>
                                    </td>
                                    <td>
                                        <div class="font-bold">@player.Username</div>
                                        @if (!string.IsNullOrWhiteSpace(player.DisplayName))
                                        {
                                            <div class="text-xs text-muted">@player.DisplayName</div>
                                        }
                                    </td>
                                    <td><span class="font-bold">@player.BestScore</span></td>
                                    <td>@player.Coins</td>
                                    <td>@player.TotalServed</td>
                                    <td>
                                        @if (player.IsSuspended)
                                        {
                                            <span class="badge badge-danger"><span class="badge-dot danger"></span>ระงับ</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success"><span class="badge-dot success"></span>ใช้งาน</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">กิจกรรมล่าสุด</h2>
            <a asp-page="/Admin/Logs/Index" class="btn-link">ดูทั้งหมด</a>
        </div>
        <div class="card-body">
            @if (Model.RecentActivities.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    </div>
                    <p class="empty-state-text">ยังไม่มีบันทึกกิจกรรม</p>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    @foreach (var activity in Model.RecentActivities)
                    {
                        var severityClass = activity.Severity switch
                        {
                            "Error" or "Critical" => "danger",
                            "Warning" => "warning",
                            "Information" => "info",
                            _ => "neutral"
                        };
                        <div style="display: flex; align-items: flex-start; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--border);">
                            <div class="badge-dot @severityClass" style="margin-top: 7px; flex-shrink: 0;"></div>
                            <div style="flex: 1; min-width: 0;">
                                <div class="font-bold text-sm">@activity.EventType</div>
                                <div class="text-xs text-muted">
                                    @activity.ActorUsername · @activity.TargetType · @activity.Outcome
                                </div>
                            </div>
                            <div class="text-xs text-muted" style="white-space: nowrap;">
                                @activity.OccurredAtUtc.ToString("HH:mm")
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
